{
  "groups": {
    "ubuntu": {
      "image": "docker.io/library/ubuntu:26.04",
      "install": "apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 python3-pip zip unzip xz-utils curl wget openssh-client rsync systemd procps psmisc iproute2 iputils-ping diffutils make cron passwd file snapd flatpak less mount util-linux && pip install --break-system-packages --quiet uv ruff && cp /usr/bin/ping /usr/local/bin/ping",
      "commands": [
        {
          "name": "uv",
          "description": "Extremely fast Python package manager",
          "sections": ["commands"],
          "depth": 2,
          "subArgs": {
            "run": { "name": "command", "isVariadic": true },
            "init": { "name": "path", "template": "folders", "isOptional": true },
            "add": { "name": "package", "isVariadic": true },
            "remove": { "name": "package", "isVariadic": true },
            "venv": { "name": "path", "template": "folders", "isOptional": true },
            "build": { "name": "source", "template": "folders", "isOptional": true },
            "publish": { "name": "file", "template": "filepaths", "isVariadic": true },
            "pip install": { "name": "package", "isVariadic": true },
            "pip uninstall": { "name": "package", "isVariadic": true },
            "pip show": { "name": "package", "isVariadic": true },
            "pip compile": { "name": "file", "template": "filepaths", "isVariadic": true },
            "pip sync": { "name": "file", "template": "filepaths", "isVariadic": true },
            "tool run": { "name": "command", "isVariadic": true },
            "tool install": { "name": "package", "isVariadic": true },
            "tool upgrade": { "name": "package", "isVariadic": true },
            "tool uninstall": { "name": "package", "isVariadic": true },
            "python install": { "name": "version", "isVariadic": true },
            "python uninstall": { "name": "version", "isVariadic": true },
            "python pin": { "name": "version" },
            "python find": { "name": "version" }
          },
          "overlay": "uv.json"
        },
        {
          "name": "ruff",
          "description": "Extremely fast Python linter and formatter",
          "sections": ["commands"],
          "depth": 2,
          "top": ["check", "format", "rule", "config", "clean", "analyze", "server", "version"],
          "overlay": "ruff.json"
        },
        {
          "name": "apt",
          "description": "Debian and Ubuntu package manager",
          "top": ["install", "remove", "update", "upgrade", "search", "show", "list", "purge", "autoremove"],
          "persistent": true,
          "subArgs": {
            "install": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "reinstall": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "remove": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "purge": { "name": "package", "isVariadic": true },
            "show": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "source": { "name": "package", "isVariadic": true },
            "download": { "name": "package", "isVariadic": true },
            "changelog": { "name": "package", "isVariadic": true },
            "build-dep": { "name": "package", "isVariadic": true },
            "depends": { "name": "package", "isVariadic": true },
            "rdepends": { "name": "package", "isVariadic": true },
            "policy": { "name": "package", "isVariadic": true },
            "showpkg": { "name": "package", "isVariadic": true },
            "showsrc": { "name": "package", "isVariadic": true },
            "search": { "name": "pattern", "template": "packages:apt" },
            "list": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "autoremove": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "satisfy": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "why": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "why-not": { "name": "package", "isVariadic": true, "template": "packages:apt" }
          },
          "overlay": "apt.json"
        },
        {
          "name": "apt-get",
          "description": "APT package handling utility",
          "top": ["install", "remove", "update", "upgrade", "search", "show", "list", "purge", "autoremove"],
          "persistent": true,
          "subArgs": {
            "install": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "reinstall": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "remove": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "purge": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "show": { "name": "package", "isVariadic": true },
            "source": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "download": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "changelog": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "build-dep": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "depends": { "name": "package", "isVariadic": true },
            "rdepends": { "name": "package", "isVariadic": true },
            "policy": { "name": "package", "isVariadic": true },
            "showpkg": { "name": "package", "isVariadic": true },
            "showsrc": { "name": "package", "isVariadic": true },
            "search": { "name": "pattern" },
            "autoremove": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "satisfy": { "name": "package", "isVariadic": true, "template": "packages:apt" }
          },
          "overlay": "apt.json"
        },
        {
          "name": "apt-cache",
          "description": "Query the APT package cache",
          "top": ["install", "remove", "update", "upgrade", "search", "show", "list", "purge", "autoremove"],
          "persistent": true,
          "subArgs": {
            "show": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "policy": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "showpkg": { "name": "package", "isVariadic": true },
            "depends": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "rdepends": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "search": { "name": "pattern", "template": "packages:apt" },
            "showsrc": { "name": "package", "isVariadic": true, "template": "packages:apt" },
            "pkgnames": { "name": "package", "isVariadic": true, "template": "packages:apt" }
          }
        },
        {
          "name": "dpkg",
          "description": "Debian package manager",
          "args": { "name": "file", "template": "filepaths", "isVariadic": true, "isOptional": true },
          "overlay": "dpkg.json"
        },
        {
          "name": "snap",
          "description": "Install and manage snaps",
          "help": ["help", "--all"],
          "sections": ["*"],
          "depth": 1,
          "top": ["install", "remove", "list", "find", "refresh", "info"],
          "subArgs": {
            "install": { "name": "package", "isVariadic": true },
            "remove": { "name": "package", "isVariadic": true },
            "info": { "name": "package", "isVariadic": true },
            "refresh": { "name": "package", "isVariadic": true },
            "revert": { "name": "package", "isVariadic": true },
            "enable": { "name": "package", "isVariadic": true },
            "disable": { "name": "package", "isVariadic": true },
            "find": { "name": "pattern" }
          }
        },
        {
          "name": "flatpak",
          "description": "Build, install and run applications and runtimes",
          "sections": ["commands"],
          "depth": 1,
          "top": ["install", "run", "list", "update", "uninstall", "search", "info"],
          "subArgs": {
            "install": { "name": "ref", "isVariadic": true, "template": "packages:flatpak" },
            "uninstall": { "name": "ref", "isVariadic": true, "template": "packages:flatpak" },
            "run": { "name": "ref", "isVariadic": true, "template": "packages:flatpak" },
            "info": { "name": "ref", "isVariadic": true, "template": "packages:flatpak" },
            "update": { "name": "ref", "isVariadic": true, "template": "packages:flatpak" },
            "search": { "name": "text" }
          }
        },
        {
          "name": "pip",
          "description": "Python package installer",
          "sections": ["commands"],
          "depth": 1,
          "top": ["install", "uninstall", "list", "show", "freeze"],
          "subArgs": {
            "install": { "name": "package", "isVariadic": true, "template": "filepaths" },
            "uninstall": { "name": "package", "isVariadic": true },
            "show": { "name": "package", "isVariadic": true },
            "download": { "name": "package", "isVariadic": true }
          }
        },
        {
          "name": "pip3",
          "description": "Python package installer",
          "sections": ["commands"],
          "depth": 1,
          "top": ["install", "uninstall", "list", "show", "freeze"],
          "subArgs": {
            "install": { "name": "package", "isVariadic": true, "template": "filepaths" },
            "uninstall": { "name": "package", "isVariadic": true },
            "show": { "name": "package", "isVariadic": true },
            "download": { "name": "package", "isVariadic": true }
          }
        },
        {
          "name": "systemctl",
          "description": "Control the systemd system and service manager",
          "sections": ["commands"],
          "depth": 1,
          "top": ["status", "start", "stop", "restart", "enable", "disable", "reload", "daemon-reload", "list-units"],
          "persistent": true,
          "subArgs": {
            "start": { "name": "unit", "isVariadic": true },
            "stop": { "name": "unit", "isVariadic": true },
            "restart": { "name": "unit", "isVariadic": true },
            "reload": { "name": "unit", "isVariadic": true },
            "status": { "name": "unit", "isVariadic": true },
            "enable": { "name": "unit", "isVariadic": true },
            "disable": { "name": "unit", "isVariadic": true },
            "is-active": { "name": "unit", "isVariadic": true },
            "is-enabled": { "name": "unit", "isVariadic": true },
            "mask": { "name": "unit", "isVariadic": true },
            "unmask": { "name": "unit", "isVariadic": true },
            "cat": { "name": "unit", "isVariadic": true },
            "edit": { "name": "unit", "isVariadic": true },
            "kill": { "name": "unit", "isVariadic": true },
            "try-restart": { "name": "unit", "isVariadic": true },
            "reload-or-restart": { "name": "unit", "isVariadic": true },
            "show": { "name": "unit", "isVariadic": true }
          }
        },
        {
          "name": "journalctl",
          "description": "Print log entries from the systemd journal",
          "args": { "name": "match", "isOptional": true, "isVariadic": true }
        },
        {
          "name": "hostnamectl",
          "description": "Query or change the system hostname",
          "sections": ["commands"],
          "depth": 1,
          "persistent": true
        },
        {
          "name": "timedatectl",
          "description": "Query or change the system time and date",
          "sections": ["commands"],
          "depth": 1,
          "persistent": true
        },
        { "name": "cat", "description": "Concatenate files and print them" },
        {
          "name": "chmod",
          "description": "Change file mode bits",
          "args": [
            { "name": "mode" },
            { "name": "file", "template": "filepaths", "isVariadic": true }
          ]
        },
        {
          "name": "chown",
          "description": "Change file owner and group",
          "args": [
            { "name": "owner[:group]" },
            { "name": "file", "template": "filepaths", "isVariadic": true }
          ]
        },
        {
          "name": "chgrp",
          "description": "Change group ownership",
          "args": [
            { "name": "group" },
            { "name": "file", "template": "filepaths", "isVariadic": true }
          ]
        },
        { "name": "ln", "description": "Make links between files" },
        { "name": "touch", "description": "Change file timestamps, create empty files" },
        { "name": "head", "description": "Print the first lines of files" },
        { "name": "tail", "description": "Print the last lines of files" },
        {
          "name": "grep",
          "description": "Print lines that match patterns",
          "args": [
            { "name": "pattern" },
            { "name": "file", "template": "filepaths", "isVariadic": true }
          ],
          "overlay": "color.json"
        },
        {
          "name": "sed",
          "description": "Stream editor for filtering and transforming text",
          "args": [
            { "name": "script" },
            { "name": "file", "template": "filepaths", "isVariadic": true }
          ]
        },
        { "name": "tar", "description": "Archive files" },
        { "name": "gzip", "description": "Compress or expand files" },
        { "name": "gunzip", "description": "Expand gzip files" },
        { "name": "xz", "description": "Compress or expand .xz and .lzma files" },
        { "name": "zip", "description": "Package and compress files", "help": ["-h"] },
        { "name": "unzip", "description": "List, test and extract zip archives", "help": ["-h"] },
        {
          "name": "curl",
          "description": "Transfer data from or to a server",
