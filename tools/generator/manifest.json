        { "name": "uname", "description": "Print system information" },
        { "name": "ls", "description": "List directory contents", "overlay": "color.json" },
        { "name": "cp", "description": "Copy files and directories" },
        { "name": "mv", "description": "Move or rename files" },
        { "name": "rm", "description": "Remove files or directories" },
        { "name": "mkdir", "description": "Make directories" },
        { "name": "ss", "description": "Investigate sockets" },
        { "name": "ping", "description": "Send ICMP echo requests to network hosts", "args": { "name": "destination" } },
        {
          "name": "mount",
