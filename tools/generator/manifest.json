    "llama": {
      "image": "docker.io/library/archlinux:latest",
      "install": "pacman -Sy --noconfirm --quiet llama-cpp",
      "commands": [
        { "name": "llama-cli", "description": "Run llama.cpp models from the command line", "args": { "name": "prompt", "isOptional": true } },
        { "name": "llama-completion", "description": "Generate text from a llama.cpp model", "args": { "name": "prompt", "isOptional": true } },
        {
          "name": "llama-quantize",
          "description": "Quantize GGUF models",
          "args": [
            { "name": "input", "template": "filepaths" },
            { "name": "output", "template": "filepaths", "isOptional": true },
            {
              "name": "type",
              "suggestions": [
                "Q1_0", "Q2_0", "Q4_0", "Q4_1", "MXFP4_MOE", "Q5_0", "Q5_1", "IQ2_XXS", "IQ2_XS",
                "IQ2_S", "IQ2_M", "IQ1_S", "IQ1_M", "TQ1_0", "TQ2_0", "Q2_K", "Q2_K_S", "IQ3_XXS",
                "IQ3_S", "IQ3_M", "Q3_K", "IQ3_XS", "Q3_K_S", "Q3_K_M", "Q3_K_L", "IQ4_NL",
                "IQ4_XS", "Q4_K", "Q4_K_S", "Q4_K_M", "Q5_K", "Q5_K_S", "Q5_K_M", "Q6_K", "Q8_0",
                "F16", "BF16", "F32"
              ]
            },
            { "name": "threads", "isOptional": true }
          ]
        },
        {
          "name": "llama-gguf",
          "description": "Read and write GGUF tensor data",
          "args": [
            { "name": "file", "template": "filepaths" },
            { "name": "mode", "suggestions": ["r", "w"] },
            { "name": "n", "isOptional": true }
          ]
        },
        { "name": "llama-server", "description": "OpenAI-compatible HTTP server for llama.cpp models" },
        { "name": "llama-bench", "description": "Benchmark llama.cpp model performance" },
        { "name": "llama-gguf-hash", "description": "Hash the tensors of a GGUF file", "args": { "name": "file", "template": "filepaths", "isVariadic": true } },
        { "name": "llama-gguf-split", "description": "Split and merge GGUF model files", "args": { "name": "file", "template": "filepaths", "isVariadic": true } },
        { "name": "llama-imatrix", "description": "Compute importance matrices for quantization" },
        { "name": "llama-perplexity", "description": "Measure a model's perplexity" },
        { "name": "llama-embedding", "description": "Generate embeddings for text" },
        { "name": "llama-tokenize", "description": "Tokenize text with a llama.cpp model" },
        { "name": "llama-mtmd-cli", "description": "Run multimodal llama.cpp models from the command line" },
        { "name": "llama-batched", "description": "Generate batched completions" },
        { "name": "llama-batched-bench", "description": "Benchmark batched generation" },
        { "name": "llama-lookup", "description": "Generate text with lookup decoding" },
        { "name": "llama-lookup-create", "description": "Create a lookup decoding cache" },
        { "name": "llama-lookup-merge", "description": "Merge lookup cache files", "args": { "name": "file", "template": "filepaths", "isVariadic": true } },
        { "name": "llama-lookup-stats", "description": "Show lookup cache statistics" },
        { "name": "llama-passkey", "description": "Run the passkey retrieval test" },
        { "name": "llama-retrieval", "description": "Run the retrieval test" },
        { "name": "llama-speculative", "description": "Generate text with speculative decoding" },
        { "name": "llama-speculative-simple", "description": "Generate text with simple speculative decoding" },
        { "name": "llama-tts", "description": "Run text to speech with a llama.cpp model" },
        { "name": "llama-idle", "description": "Keep a model loaded without generating" },
        { "name": "llama-eval-callback", "description": "Evaluate a model with a callback" },
        { "name": "llama-fit-params", "description": "Fit model parameters to the available memory" },
        { "name": "llama-lookahead", "description": "Generate text with lookahead decoding" },
