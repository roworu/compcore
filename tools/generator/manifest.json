          "description": "Clean the pacman package cache",
          "args": { "name": "package", "isVariadic": true, "isOptional": true, "template": "packages:pacman" }
        },
        {
          "name": "pactree",
          "description": "Show a package's dependency tree",
          "args": { "name": "package", "template": "packages:pacman" }
        },
        { "name": "checkupdates", "description": "List pending pacman updates" },
        {
          "name": "updpkgsums",
          "description": "Update the checksums of a PKGBUILD",
          "args": { "name": "file", "template": "filepaths", "isOptional": true }
        },
        { "name": "mkinitcpio", "description": "Create an initial ramdisk", "overlay": "mkinitcpio.json" },
        { "name": "reflector", "description": "Fetch and rank Arch Linux mirrors", "overlay": "reflector.json" },
        {
          "name": "pacstrap",
          "description": "Install packages into a new root",
          "args": [
            { "name": "root", "template": "folders" },
            { "name": "package", "isVariadic": true, "isOptional": true, "template": "packages:pacman" }
          ]
        },
        {
          "name": "genfstab",
          "description": "Generate fstab entries for a root",
          "args": { "name": "root", "template": "folders" }
        }
      ]
    },
    "aur": {
      "image": "docker.io/library/archlinux:latest",
      "install": "pacman -Syu --noconfirm --needed --quiet base-devel git && useradd -m build && echo 'build ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers && for p in yay-bin paru-bin; do su build -c \"cd && git clone -q https://aur.archlinux.org/$p.git && cd $p && makepkg -si --noconfirm\"; done",
      "commands": [
        {
          "name": "paru",
          "description": "AUR helper and pacman wrapper",
          "args": { "name": "package", "isVariadic": true, "template": "packages:pacman" },
          "extraHelp": [
            ["-D", "--help"],
            ["-F", "--help"],
            ["-Q", "--help"],
            ["-R", "--help"],
            ["-S", "--help"],
            ["-T", "--help"],
            ["-U", "--help"]
          ],
          "overlay": "paru.json"
        },
        {
          "name": "yay",
          "description": "AUR helper and pacman wrapper",
          "args": { "name": "package", "isVariadic": true, "template": "packages:pacman" },
          "extraHelp": [
            ["-D", "--help"],
            ["-F", "--help"],
            ["-Q", "--help"],
            ["-R", "--help"],
            ["-S", "--help"],
            ["-T", "--help"],
            ["-U", "--help"]
          ],
          "overlay": "yay.json"
        }
      ]
    },
    "opensuse": {
      "image": "registry.opensuse.org/opensuse/tumbleweed:latest",
      "install": "true",
      "commands": [
        {
          "name": "zypper",
          "description": "openSUSE package manager",
          "help": ["help"],
          "sections": ["*"],
          "subHelp": ["help", "{}"],
          "depth": 1,
          "top": ["install", "remove", "update", "search", "info", "refresh", "dist-upgrade"],
          "persistent": true,
          "subArgs": {
            "install": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "remove": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "info": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "update": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "search": { "name": "pattern", "template": "packages:zypper" },
            "removeptf": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "verify": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "source-install": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "patch": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "dist-upgrade": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "what-provides": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "addlock": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "removelock": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "download": { "name": "package", "isVariadic": true, "template": "packages:zypper" },
            "source-download": { "name": "package", "isVariadic": true, "template": "packages:zypper" }
          }
        }
      ]
    },
    "alpine": {
      "image": "docker.io/library/alpine:latest",
      "install": "true",
      "commands": [
        {
          "name": "apk",
          "description": "Alpine package manager",
          "sections": ["*"],
          "depth": 1,
          "top": ["add", "del", "update", "upgrade", "search", "info"],
          "persistent": true,
          "subArgs": {
            "add": { "name": "package", "isVariadic": true, "template": "packages:apk" },
            "del": { "name": "package", "isVariadic": true, "template": "packages:apk" },
            "info": { "name": "package", "isVariadic": true, "template": "packages:apk" },
            "fetch": { "name": "package", "isVariadic": true, "template": "packages:apk" },
            "fix": { "name": "package", "isVariadic": true, "template": "packages:apk" },
            "policy": { "name": "package", "isVariadic": true, "template": "packages:apk" },
            "search": { "name": "pattern", "template": "packages:apk" },
            "upgrade": { "name": "package", "isVariadic": true, "template": "packages:apk" }
          }
        }
      ]
